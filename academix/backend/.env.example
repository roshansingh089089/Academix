# Hosting providers normally supply PORT; map it to SERVER_PORT if necessary.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=production

# Must point to a mounted persistent disk in production.
ACADEMIX_DB_PATH=/data/academix.db

# Optional only for browsers calling the backend directly. Comma-separated.
# Same-origin Vercel rewrites do not require the Vercel origin here.
ALLOWED_ORIGINS=http://localhost:5173

# Upload limit accepted by Spring Boot. The reverse proxy/provider may enforce a lower limit.
MAX_UPLOAD_SIZE=100MB
